# Copy to .env (gitignored) and fill in. Values live in Netlify env / password manager —
# never commit them; the repo is public.
NETLIFY_TOKEN=            # Netlify personal access token (nfp_…)
SITE_ID=                  # Netlify site id
SUPA_MGMT_TOKEN=          # Supabase management token (sbp_…)
STRIPE_WHSEC=             # Stripe webhook signing secret (whsec_…)
STRIPE_SECRET_KEY=        # Stripe API secret key (sk_test_/sk_live_) — powers the billing portal
DATAGOLF_KEY=
RESEND_KEY=               # sending-only key (re_…)
PLINK_MAJOR=              # Stripe payment-link ids for plan detection
PLINK_EVENT=
PLINK_ANNUAL=
PLINK_SEASON=
SETUP_KEY=                # guard key for the admin-setup function (any long random string)
OWNER_SEED_PASSWORD=       # password for the support@ owner account (seeded by admin-setup)
